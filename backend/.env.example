# Kwara L-PRES Website Backend Environment Configuration

# 1. PostgreSQL Database Configuration (RDS PostGIS / Production Postgres)
# Example: postgresql+psycopg2://user:password@rds-endpoint.amazonaws.com:5432/lpres_db
DATABASE_URL=postgresql://user:password@localhost:5432/lpres_db

# 2. AWS S3 Media Bucket Configuration
S3_BUCKET_NAME=lpres-intelligence-docs-dev
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# 3. Security & Admin Credentials
SECRET_KEY=change-this-to-a-secure-random-secret-key
ADMIN_SEED_PASSWORD=change-this-to-your-admin-password
